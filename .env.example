# --- Datenbank ---
DATABASE_URL="postgresql://ucradar:ucradar@localhost:5433/ucradar?schema=public"

# --- Anwendung ---
# Basis-URL der Anwendung (fuer Magic Links, Absender in E-Mails)
APP_BASE_URL="http://localhost:3000"

# Geheimnis fuer Session-Cookies (Admin) und signierte Tokens. Mind. 32 Zeichen.
SESSION_SECRET="bitte-aendern-mindestens-zweiunddreissig-zeichen"

# Geheimnis fuer die Ableitung von Zugangs-Token-Hashes (HMAC).
TOKEN_HASH_SECRET="bitte-aendern-ebenfalls-ein-langes-geheimnis"

# --- OpenProject (siehe OPENPROJECT_ZUGANG.md) ---
OP_BASE_URL="https://openproject.ki-partner.tech"
# Admin-API-Token. HTTP Basic Auth: Benutzername "apikey", Passwort = dieser Wert.
# Niemals committen. Lokal zum Testen eintragen, in Produktion über SOPS+age.
OP_API_KEY=""
# Pfad zur Mapping-Datei (Custom-Field-IDs etc.), Standard: ./openproject-mapping.json
OP_MAPPING_FILE="./openproject-mapping.json"

# --- E-Mail (Magic Links) ---
# leer lassen => Mails werden nur in die Konsole geloggt (Entwicklung)
SMTP_URL=""
MAIL_FROM="UC-Radar <ideen@ki-partner.tech>"

# --- Interne Jobs ---
# Bearer-Token für /api/jobs/* (Fortschritt zurücklesen, KI-Anreicherung).
# Leer => Job-Endpunkte geben 503 zurück.
JOB_TOKEN=""

# --- KI-Anreicherung (Konzept 4.6, optional, einwilligungspflichtig) ---
# Leer lassen => keinerlei externe KI-Verarbeitung (Standard, Normalfall).
# KI_PROVIDER: "" | "mock" (nur Tests) | "openai-compatible"
KI_PROVIDER=""
KI_BASE_URL=""          # z. B. https://api.eu.example.tld/v1  (EU-Endpunkt, AV-Vertrag!)
KI_API_KEY=""
KI_MODELL="gpt-4o-mini"
# Wird im Einwilligungsdialog namentlich genannt:
KI_ANBIETER_NAMEN="OpenAI oder Google AI"
