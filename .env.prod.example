# Vorlage für die Produktions-Secrets.
# Vor dem ersten Deploy als .env.prod.sops.yaml mit SOPS + age verschlüsseln:
#   sops --encrypt --age <age-public-key> .env.prod > .env.prod.sops.yaml
# deploy.sh entschlüsselt sie wieder nach .env.prod.

DATABASE_URL="postgresql://ucradar:CHANGEME@db:5432/ucradar?schema=public"
APP_BASE_URL="https://ideen.ki-partner.tech"

SESSION_SECRET="openssl rand -base64 36"
TOKEN_HASH_SECRET="openssl rand -base64 36"

OP_BASE_URL="https://openproject.ki-partner.tech"
OP_API_KEY="CHANGEME"
OP_MAPPING_FILE="./openproject-mapping.json"

SMTP_URL="smtps://user:pass@mail.example.tld:465"
MAIL_FROM="UC-Radar <ideen@ki-partner.tech>"

# Bearer-Token für den Cron-Job /api/jobs/op-status
JOB_TOKEN="openssl rand -hex 24"

# nur für docker-compose.prod.yml (db-Service)
POSTGRES_USER="ucradar"
POSTGRES_PASSWORD="CHANGEME"
POSTGRES_DB="ucradar"
