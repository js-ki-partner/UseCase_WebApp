# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
# .env wird auf dem Server bei jedem Deploy aus secrets.enc.yaml generiert
# (SOPS + age, siehe DEPLOYMENT.md) und darf NIE committet werden.
.env*
!.env.example
# secrets.enc.yaml (Chiffretext) und .sops.yaml gehören laut DEPLOYMENT.md ins Repo
# und werden hier NICHT ignoriert.

# vercel
.vercel

# openproject-mapping.json enthält nur instanzspezifische IDs, keine Geheimnisse
# und darf laut Runbook (Abschnitt 6) ins Repository — daher NICHT ignoriert.

# lokale Secrets / entschlüsselte Kopien
/secrets/
age-key.txt

# typescript
*.tsbuildinfo
next-env.d.ts
